# -----------------------------------------------------------------------------
# Secrets and machine-specific configuration
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

*.vault
*.secret
*.secrets
secrets/
credentials/
admin_password
htpasswd
.htpasswd

# Private keys and certificate bundles (public certificates may be committed)
*.key
*.pem
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*

# -----------------------------------------------------------------------------
# JavaScript / TypeScript dependencies and generated output
# -----------------------------------------------------------------------------
node_modules/
dist/
build/
coverage/
.nyc_output/
.vite/
.turbo/
.parcel-cache/
.eslintcache
*.tsbuildinfo

# Package-manager caches and debug logs
.npm/
.yarn/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# Python and test caches (Nagios plugins and helper scripts)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# -----------------------------------------------------------------------------
# Ansible runtime files and locally generated credentials
# -----------------------------------------------------------------------------
.ansible/
*.retry
ansible/facts/
ansible/.cache/
ansible/*.log
ansible/inventory/hosts.local.ini
ansible/inventory/group_vars/*/vault.yml
ansible/inventory/group_vars/*/secrets.yml

