define command {
    command_name    check_nrpe_attendance
    command_line    $USER1$/check_nrpe -H $HOSTADDRESS$ -t 20 -c $ARG1$
}

define command {
    command_name    check_attendance_api
    command_line    $USER1$/check_attendance_api -H $HOSTADDRESS$ -p 5173 -w 1.0 -c 3.0
}

define command {
    command_name    check_attendance_frontend
    command_line    $USER1$/check_http -H $HOSTADDRESS$ -p 5173 -u /
}

define host {
    use                     generic-host
    host_name               attendance-app
    alias                   Student Attendance Application VM
    address                 {{ nagios_app_address }}
    check_command           check-host-alive
    max_check_attempts      3
    check_interval          1
    retry_interval          1
}

define service {
    use                     generic-service
    host_name               attendance-app
    service_description     Host Ping
    check_command           check_ping!100.0,20%!500.0,60%
}

define service {
    use                     generic-service
    host_name               attendance-app
    service_description     Frontend HTTP
    check_command           check_attendance_frontend
}

define service {
    use                     generic-service
    host_name               attendance-app
    service_description     API Health and Response Time
    check_command           check_attendance_api
}

define service {
    use                     generic-service
    host_name               attendance-app
    service_description     CPU Usage
    check_command           check_nrpe_attendance!check_cpu
}

define service {
    use                     generic-service
    host_name               attendance-app
    service_description     Memory Usage
    check_command           check_nrpe_attendance!check_memory
}

define service {
    use                     generic-service
    host_name               attendance-app
    service_description     Root Disk Usage
    check_command           check_nrpe_attendance!check_disk_root
}

define service {
    use                     generic-service
    host_name               attendance-app
    service_description     Docker Application Stack
    check_command           check_nrpe_attendance!check_docker_stack
}

define service {
    use                     generic-service
    host_name               attendance-app
    service_description     MongoDB Container Health
    check_command           check_nrpe_attendance!check_mongodb
}

