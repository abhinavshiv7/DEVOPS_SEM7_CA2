# Copy this file to .env only on the application VM.
# Generate a secret with: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters

APP_BIND_ADDRESS=192.168.56.10
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://192.168.56.10:5173

# The local lab uses HTTP on an isolated host-only network. Set this to true
# when HTTPS is configured.
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_MS=604800000
UPLOAD_MAX_BYTES=5242880

